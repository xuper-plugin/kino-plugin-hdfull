{
  "id": "hdfull-local",
  "name": "HDFull",
  "version": "0.5.6",
  "apiVersion": 19,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series de HDFull en servidores que cargan sin captcha (Vidmoly, Streamtape, Mixdrop). Catálogo que se actualiza solo y pantalla propia; títulos y pósters de TMDB.",
  "author": "xuper-plugin",
  "categories": [
    "movies",
    "series"
  ],
  "capabilities": [
    "home",
    "browse",
    "search",
    "resolve",
    "episodes",
    "catalog",
    "screen",
    "schedule",
    "storageLarge"
  ],
  "hosts": [
    "vidmoly.biz",
    "vidmoly.me",
    "vidmoly.to",
    "streamtape.com",
    "mixdrop.bz",
    "mxdrop.click",
    "mixdrop.co",
    "mixdrop.ag",
    "mixdrop.ps",
    "mixdrop.sb",
    "mixdrop.to",
    "vidoza.net",
    "gamovideo.com",
    "gamovideo.net"
  ],
  "streamHosts": "any",
  "fetchHosts": "any",
  "section": {
    "label": "HDFull",
    "labelEn": "HDFull"
  },
  "screen": {
    "label": "HDFull",
    "labelEn": "HDFull",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": ["menu", "settings"],
    "settingsButton": { "label": "Abrir plugin", "labelEn": "Open plugin" },
    "settingsIn": "both"
  },
  "jobs": [
    {
      "id": "refresh",
      "label": { "es": "Actualizar catálogo", "en": "Refresh catalog" },
      "everyMin": 360,
      "everyOptions": [180, 360, 720, 1440]
    }
  ],
  "discoverable": true,
  "settings": [
    {
      "key": "audio",
      "type": "select",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "default": "E",
      "options": [
        {
          "value": "E",
          "label": "Castellano",
          "labelEn": "Spanish (Spain)"
        },
        {
          "value": "L",
          "label": "Latino",
          "labelEn": "Latin American Spanish"
        },
        {
          "value": "S",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ],
      "hint": "Esa copia va primera; las demás quedan en el menú Servidor.",
      "hintEn": "That copy plays first; the rest stay in the Server menu."
    },
    {
      "key": "indexStatus",
      "type": "status",
      "label": "Índice",
      "labelEn": "Index"
    }
  ]
}