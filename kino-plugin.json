{
  "id": "hdfull-local",
  "name": "HDFull",
  "version": "0.7.0",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series de HDFull en servidores que cargan sin captcha (Vidmoly, Streamtape, Mixdrop). Catálogo que se actualiza solo y pantalla propia; títulos y pósters de TMDB.",
  "author": "xuper-plugin",
  "categories": [
    "movies",
    "series"
  ],
  "capabilities": [
    "home",
    "browse",
    "search",
    "resolve",
    "episodes",
    "catalog",
    "screen",
    "schedule",
    "storageLarge"
  ],
  "hosts": [
    "vidmoly.biz",
    "vidmoly.me",
    "vidmoly.to",
    "streamtape.com",
    "mixdrop.bz",
    "mxdrop.click",
    "mixdrop.co",
    "mixdrop.ag",
    "mixdrop.ps",
    "mixdrop.sb",
    "mixdrop.to",
    "vidoza.net",
    "gamovideo.com",
    "gamovideo.net"
  ],
  "streamHosts": "any",
  "fetchHosts": "any",
  "section": {
    "label": "HDFull",
    "labelEn": "HDFull"
  },
  "screen": {
    "label": "HDFull",
    "labelEn": "HDFull",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir plugin",
      "labelEn": "Open plugin"
    },
    "settingsIn": "both"
  },
  "jobs": [
    {
      "id": "refresh",
      "label": {
        "es": "Actualizar catálogo",
        "en": "Refresh catalog"
      },
      "everyMin": 360,
      "everyOptions": [
        180,
        360,
        720,
        1440
      ]
    }
  ],
  "setup": {
    "route": "setup",
    "inputs": {
      "audio": {
        "type": "select",
        "options": [
          "E",
          "L",
          "S"
        ]
      }
    }
  },
  "discoverable": true,
  "settings": [
    {
      "key": "audio",
      "type": "select",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "default": "E",
      "options": [
        {
          "value": "E",
          "label": "Castellano",
          "labelEn": "Spanish (Spain)"
        },
        {
          "value": "L",
          "label": "Latino",
          "labelEn": "Latin American Spanish"
        },
        {
          "value": "S",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ],
      "hint": "Esa copia va primera; las demás quedan en el menú Servidor.",
      "hintEn": "That copy plays first; the rest stay in the Server menu."
    },
    {
      "key": "indexStatus",
      "type": "status",
      "label": "Índice",
      "labelEn": "Index"
    }
  ],
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "resolveAhead": true,
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?"
          },
          "out": "Item[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "11c6cff0e17513496e6081be42df040455730eeecfeedf44621899f1bd0770f1110b974f82c56b10b84e1ea7af8f446ff97c4d7ec5a2f645eebec86a80d1bf03"
  }
}
